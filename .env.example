# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo checkout — OFF automatically when Paystack keys are set.
# Only used when Paystack keys are missing (local demo).
NEXT_PUBLIC_DEMO_CHECKOUT=true

# Supabase (required for persistent catalog/orders/stock)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack (GHS — Ghana). When both keys are set, demo checkout is disabled.
# Hosted checkout includes Mobile Money (MTN, Telecel, AirtelTigo) + card.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Email (Resend) — logs to console if unset
RESEND_API_KEY=
RESEND_FROM=Lit Perfumes <onboarding@resend.dev>
ADMIN_EMAIL=you@example.com

# WhatsApp click-to-chat (country code, no +)
WHATSAPP_BUSINESS_NUMBER=233540357260
NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=233540357260

# COD cap (GHS)
COD_MAX_GHS=2000

# Admin login (owner + dev). Optional; blank = reuse ADMIN_PASSWORD as session token.
ADMIN_PASSWORD=change-me-strong
# ADMIN_SESSION_SECRET=